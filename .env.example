# cp .env.example .env — opcional para Docker, obligatorio sin Docker

# --- API (/server) ---
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/kanban # con Docker Compose: mongodb://mongo:27017/kanban
CORS_ORIGIN=http://localhost:5173

# Secretos de desarrollo, no válidos para producción. Genera los tuyos con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me-before-deploying
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-before-deploying
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# Invitaciones a tableros
INVITATION_EXPIRES_DAYS=7
APP_BASE_URL=http://localhost:5173 # usada para construir el enlace /invite/:token
APP_NAME=MakeIt # usado en el asunto de los mensajes de invitación

# Tiempo real (Socket.io). Usa el mismo CORS_ORIGIN que la API para el
# handshake del socket.
SOCKET_PATH=/socket.io

# Observabilidad y operación
LOG_LEVEL=info # fatal|error|warn|info|debug|trace|silent (en tests: silent)
SHUTDOWN_TIMEOUT_MS=10000 # margen para terminar peticiones en curso tras SIGTERM

# Proxy inverso y límites por IP (cada 15 min)
TRUST_PROXY=0 # nº de proxies delante de la API (1 en Render o detrás de Caddy)
AUTH_RATE_LIMIT_MAX=20
INVITATIONS_RATE_LIMIT_MAX=30

# --- Docker Compose ---
# El producto se llama MakeIt, pero la base de datos se queda como "kanban":
# es el nombre con el que ya existen datos en el volumen de Mongo, y
# renombrarla los dejaría huérfanos. Ver README (Decisiones técnicas).
MONGO_DB=kanban
MONGO_PORT=27017
CLIENT_PORT=5173
