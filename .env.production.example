# ============================================================================
# Variables de PRODUCCIÓN de MakeIt (imagen única: API + Socket.io + frontend)
# ============================================================================
# Plantilla SIN valores reales. Úsala así:
#   - Render: introduce los secretos en el panel (Environment). Ver DEPLOY.md.
#   - VPS:    cp .env.production.example .env.production  (git lo ignora)
#   - Scripts contra Atlas desde tu ordenador (índices, seed de demo):
#       cp .env.production.example .env.atlas.local        (git lo ignora)
#
# Genera CADA secreto por separado, con:
#   openssl rand -base64 48
# La app NO arranca en producción con secretos de ejemplo, de menos de 32
# caracteres o iguales entre sí, ni sin MONGO_URI o APP_BASE_URL.

# --- Obligatorias -----------------------------------------------------------

NODE_ENV=production

# Cadena de conexión de MongoDB Atlas (botón Connect -> Drivers). Sustituye
# <usuario> y <contraseña> por el usuario de APLICACIÓN (no el admin) y añade
# el nombre de la base de datos (makeit) antes del "?".
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/makeit?retryWrites=true&w=majority

# Dos secretos DISTINTOS (openssl rand -base64 48 cada uno).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# URL pública de la app, sin barra final (base de los enlaces de invitación).
# Render: https://<nombre-del-servicio>.onrender.com. Con dominio propio, ese.
APP_BASE_URL=https://<tu-servicio>.onrender.com

# --- Imagen única -----------------------------------------------------------

# La API sirve también el frontend compilado (ya viene así en la imagen).
SERVE_CLIENT=true
# Nº de proxies delante de la app: 1 en Render y detrás de Caddy.
TRUST_PROXY=1
# PORT: Render lo inyecta solo (no lo definas allí). En un VPS, 4000.
# PORT=4000

# --- Opcionales (valor por defecto entre paréntesis) ------------------------

# LOG_LEVEL=info               (fatal|error|warn|info|debug|trace|silent)
# APP_NAME=MakeIt              (asunto de los mensajes de invitación)
# BCRYPT_ROUNDS=12             (coste de bcrypt; 12 es un buen equilibrio)
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=30d   (también es la caducidad de la cookie de sesión)
# INVITATION_EXPIRES_DAYS=7
# AUTH_RATE_LIMIT_MAX=20       (peticiones a /api/auth por IP cada 15 min)
# INVITATIONS_RATE_LIMIT_MAX=30
# SHUTDOWN_TIMEOUT_MS=10000    (margen para terminar peticiones tras SIGTERM)
# CORS_ORIGIN=                 (NO la definas: cliente y API comparten origen)

# --- Solo para scripts que ejecutas tú (NO van en Render) -------------------

# npm run seed:demo: contraseña del usuario de demostración (mín. 12 car.).
# DEMO_USER_EMAIL=demo@makeit.app
# DEMO_USER_PASSWORD=

# npm run smoke: cuenta fija que usa el smoke test (se registra la 1.ª vez).
# SMOKE_EMAIL=smoke@makeit.app
# SMOKE_PASSWORD=

# --- Solo VPS (docker-compose.prod.yml + Caddy) -----------------------------

# Dominio que apunta a tu VPS: Caddy obtiene el certificado HTTPS solo.
# DOMAIN=makeit.tudominio.com
# Si usas el Mongo del propio compose (perfil "mongo") en vez de Atlas:
# MONGO_ROOT_USER=makeit
# MONGO_ROOT_PASSWORD=          (openssl rand -base64 32)
# y entonces: MONGO_URI=mongodb://<MONGO_ROOT_USER>:<MONGO_ROOT_PASSWORD>@mongo:27017/makeit?authSource=admin
